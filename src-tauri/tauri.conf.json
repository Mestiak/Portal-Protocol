{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portal Protocol",
  "version": "0.6.9",
  "identifier": "com.usuario.gw2-log-uploader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Portal Protocol - dps.report log uploader",
        "width": 1000,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "icons/installer/sidebar.bmp",
        "headerImage": "icons/installer/header.bmp",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwMkQxN0E4NjdGMjk5MTIKUldRU21mSm5xQmN0d09BRHhDM1FmTDlZbGtxUlRFNElCRldNTkVVYWNuODN4SmRNVXZKa21RYkIK"
    }
  }
}
